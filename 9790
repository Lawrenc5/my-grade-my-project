const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const subjects=["English","Kiswahili","Mathematics","Integrated Science","Social Studies","Pre-Technical Studies","Creative Arts & Sports","Agriculture","Religious Education","Business Studies"];
const lessons=[["English","Reading for meaning","Identify the main idea and supporting details in a short text."],["Mathematics","Understanding fractions","A fraction represents equal parts of a whole. The numerator is the top number; the denominator is the bottom number."],["Integrated Science","A fair investigation","A fair test changes one factor at a time and keeps other conditions constant."],["Social Studies","Responsible citizenship","Responsible citizens respect others and protect shared resources."],["Pre-Technical Studies","The design process","Identify a need, research, generate ideas, make, test and improve."],["Agriculture","Soil and plant growth","Soil provides support, water, air and nutrients for plants."]];
let page="home", grade=localStorage.getItem("mgmp-grade")||"Grade 7", completed=JSON.parse(localStorage.getItem("mgmp-done")||"[]"), projects=JSON.parse(localStorage.getItem("mgmp-projects")||"[]"), chat=[];
$("#grade").value=grade;$("#grade").onchange=e=>{grade=e.target.value;localStorage.setItem("mgmp-grade",grade)};
function go(p){page=p;$$("nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===p));render()}
function render(){let title="",sub="",html="";
if(page==="home"){title="Welcome to your learning space";sub="Choose an activity and make progress today.";html=`<div class="hero"><h2>${grade}: learn, practise and create</h2><p>Your independent learning space for Kenyan junior schools.</p></div><div class="grid"><div class="card"><h3>My Classroom</h3><p>Explore learning areas and sample lessons.</p><button data-go="classroom">Open classroom</button></div><div class="card"><h3>My Revision</h3><p>Practise questions and check your understanding.</p><button data-go="revision">Start revision</button></div><div class="card"><h3>✦ AI Tutor</h3><p>Ask for explanations and guided practice.</p><button data-go="tutor">Ask tutor</button></div></div><div class="card"><b>${completed.length}</b> lessons completed · <b>${projects.length}</b> projects saved</div>`}
if(page==="classroom"){title="My Classroom";sub="Choose a learning area or open a sample lesson.";html=`<div class="grid">${subjects.map(s=>`<div class="card"><h3>${s}</h3><p class="small">CBC learning area</p></div>`).join("")}</div><div class="card"><h2>Sample lessons</h2>${lessons.map((l,i)=>`<div class="item"><b>${l[1]}</b><p class="small">${l[0]} · ${l[2]}</p><button data-lesson="${i}">Mark as completed</button></div>`).join("")}</div>`}
if(page==="revision"){title="My Revision";sub="A short practice check.";let qs=[["What is the top number in a fraction called?",["Numerator","Denominator"],0],["How many variables should change in a fair test?",["One","All"],0],["Which is responsible citizenship?",["Protect shared resources","Damage public property"],0]];html=`<div class="card"><form id="quiz">${qs.map((q,i)=>`<p><b>${i+1}. ${q[0]}</b></p>${q[1].map((a,j)=>`<label><input type="radio" name="q${i}" value="${j}" required style="display:inline;width:auto">${a}</label>`).join("<br>")}`).join("")}<button class="primary">Mark answers</button></form><div id="score"></div></div>`}
if(page==="projects"){title="My Projects";sub="Plan a project and track its progress.";html=`<div class="card"><form id="project"><label>Project title<input name="title" required maxlength="70"></label><label>Describe your idea<textarea name="desc" required maxlength="500"></textarea></label><label>Learning area<select name="area">${subjects.map(s=>`<option>${s}</option>`).join("")}</select></label><button class="primary">Save project</button></form></div><div class="card"><h2>Saved projects</h2>${projects.map(p=>`<div class="item"><b>${p.title}</b><p class="small">${p.area}</p></div>`).join("")||"No projects saved yet."}</div>`}
if(page==="progress"){title="My Progress";sub="Activity stored on this device.";html=`<div class="card"><h2>${completed.length} lessons completed</h2><p>${completed.map(x=>"✓ "+x).join("<br>")||"Start a lesson to record progress."}</p></div>`}
if(page==="teacher"){title="Teacher Space";sub="A simple lesson planning workspace.";html=`<div class="card"><h2>Lesson plan builder</h2><form id="plan"><label>Learning area<select name="area">${subjects.map(s=>`<option>${s}</option>`).join("")}</select></label><label>Topic<input name="topic" required></label><label>Learning outcome<textarea name="outcome" required></textarea></label><button class="primary">Create draft plan</button></form><div id="planout"></div></div>`}
if(page==="tutor"){title="AI Tutor";sub="Ask a question about your learning.";html=`<div class="card"><p class="small">Tutor context: ${grade}. Ask for a simple explanation, guided solution or revision questions.</p><div id="chat" class="chat"><div class="bubble bot">Hello! What topic are you learning today?</div></div><form id="ask" class="chatform"><textarea id="question" maxlength="1500" placeholder="Type your question…" required></textarea><button class="primary">Ask tutor</button></form><p class="hint">Do not share your full name, phone number, address, passwords or other private information. AI answers may contain mistakes; check important work with your teacher.</p></div>`}
$("#heading").textContent=title;$("#subheading").textContent=sub;$("#content").innerHTML=html}
$("#mainNav");$("nav").onclick=e=>{let b=e.target.closest("[data-page]");if(b)go(b.dataset.page)};
$("#content").onclick=e=>{let g=e.target.closest("[data-go]");if(g)go(g.dataset.go);let l=e.target.closest("[data-lesson]");if(l){let name=lessons[+l.dataset.lesson][1];if(!completed.includes(name))completed.push(name);localStorage.setItem("mgmp-done",JSON.stringify(completed));l.textContent="Completed ✓";}};
$("#content").onsubmit=async e=>{e.preventDefault();
if(e.target.id==="quiz"){let d=new FormData(e.target),score=0;[0,0,0].forEach((_,i)=>{if(+d.get("q"+i)===0)score++});$("#score").textContent=`Your score: ${score}/3`;}
if(e.target.id==="project"){let d=new FormData(e.target);projects.push({title:d.get("title"),desc:d.get("desc"),area:d.get("area")});localStorage.setItem("mgmp-projects",JSON.stringify(projects));render();}
if(e.target.id==="plan"){let d=new FormData(e.target);$("#planout").textContent=`Draft saved locally: ${d.get("topic")} — ${d.get("outcome")}`;}
if(e.target.id==="ask"){let q=$("#question").value.trim();if(!q)return;let box=$("#chat"),u=document.createElement("div");u.className="bubble user";u.textContent=q;box.appendChild(u);$("#question").value="";let wait=document.createElement("div");wait.className="bubble bot";wait.textContent="Thinking…";box.appendChild(wait);try{let r=await fetch("/api/tutor",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({message:q,grade,history:chat.slice(-8)})});let data=await r.json();if(!r.ok)throw Error(data.error||"Tutor unavailable");wait.textContent=data.reply;chat.push({role:"user",content:q},{role:"assistant",content:data.reply});}catch(err){wait.textContent="The AI Tutor service is not connected yet. Please check that the backend is deployed and configured."; }box.scrollTop=box.scrollHeight;}
};
window.addEventListener("online",()=>$("#online").textContent="Online");window.addEventListener("offline",()=>$("#online").textContent="Offline · local features");$("#online").textContent=navigator.onLine?"Online":"Offline · local features";
if("serviceWorker"in navigator&&location.protocol.startsWith("http"))navigator.serviceWorker.register("/sw.js").catch(()=>{});
go("home");
